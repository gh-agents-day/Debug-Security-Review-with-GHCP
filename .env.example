# TaskForce Pro — Environment Variables
# =====================================================
# Copy this file to .env and fill in REAL values.
# NEVER commit .env to version control.
# =====================================================

# ── Application ──────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────
# PostgreSQL (production) — replace with your connection details
DATABASE_URL=postgresql://taskforce_user:CHANGE_ME@db-host:5432/taskforce_pro
# For local development / workshop:
# DATABASE_URL=sqlite:///./taskforce.db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://:CHANGE_ME@redis-host:6379/0

# ── JWT Authentication ────────────────────────────────
# Must be at least 32 random characters — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_min_32_chars_random_string_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Admin Account (set before first run) ─────────────
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=CHANGE_ME_use_strong_password

# ── AWS S3 ────────────────────────────────────────────
# Use IAM roles in production — never hardcode keys
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=us-east-1
S3_BUCKET_NAME=taskforce-pro-attachments

# ── Email (SendGrid) ─────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME

# ── Slack Notifications ───────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE_ME

# ── Stripe Payments ───────────────────────────────────
STRIPE_API_KEY=sk_live_CHANGE_ME

# ── Twilio SMS ────────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME

# ── Session ───────────────────────────────────────────
SESSION_SECRET_KEY=CHANGE_ME_another_random_32_char_string
